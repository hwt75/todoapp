# Generate a pair with: npx web-push generate-vapid-keys
#
# The public key is exposed to the browser by design — it identifies this server
# to the push service. The private key signs pushes and must never reach the
# client bundle or a NEXT_PUBLIC_* variable.

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
