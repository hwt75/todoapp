# Generate a pair with: npx web-push generate-vapid-keys
#
# The public key is exposed to the browser by design — it identifies this server
# to the push service. The private key signs pushes and must never reach the
# client bundle or a NEXT_PUBLIC_* variable.

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Supabase — the project the app talks to.
#
# The publishable key is exposed to the browser by design; it grants nothing on its
# own, because authorization lives in RLS (AD-7) and never in application code. That
# is only true if RLS is on from the first table, which AD-7 requires.
#
# The secret / service_role key is NOT here and must never be. It bypasses every RLS
# policy. When an Edge Function needs it, it is set in Supabase's own server
# environment — not in this file, not in the repo, not on Vercel's client build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
